# ============================================================
# research-figure-lab 環境変数のサンプル
# このファイルを .env にコピーして値を書き換えてください（.env は Git に含まれません）。
# 各自の環境に合わせて設定
# ============================================================

# --- 入出力の場所（任意）-------------------------------------
# JupyterLab 向けスクリプトの入力・出力フォルダを上書きします。
# 未設定の場合は各スクリプト冒頭の既定値（Desktop/graph/... など）が使われます。
FIGLAB_INPUT_DIR=./data/sample
FIGLAB_OUTPUT_DIR=./output/sample_growth

# --- 確定時のコピー先（任意）----------------------------------
# 「確定」時にノートブックと図をコピーするフォルダ。
# 例：Google ドライブ for desktop の同期フォルダ（G:/My Drive/figures など）
FIGLAB_EXPORT_DIR=./export

# --- API キー（任意・通常は不要）------------------------------
# Claude Code と Codex は通常、各アプリのアカウントログインで動くためキーは不要です。
# CI などで API キー認証を使う場合のみ設定してください。絶対にコミットしないこと。
ANTHROPIC_API_KEY=YOUR_API_KEY
CODEX_API_KEY=YOUR_API_KEY
