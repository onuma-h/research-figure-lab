# ===== 秘密情報 =====
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials*.json
secrets*.json
token*.json

# ===== Claude Code / Codex の個人設定 =====
.claude/settings.local.json
.codex/config.toml
.codex/auth.json

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/
